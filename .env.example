POSTGRES_DB=mlops
POSTGRES_USER=mlops
POSTGRES_PASSWORD=local-postgres-change-me
RABBITMQ_USER=mlops
RABBITMQ_PASSWORD=local-rabbit-change-me
GRAFANA_PASSWORD=local-grafana-change-me
APP_PORT=8000
MLFLOW_PORT=5000
LOG_LEVEL=INFO
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=iris-classification
MLFLOW_MODEL_NAME=iris-classifier
MLFLOW_MODEL_ALIAS=champion
MODEL_CACHE_SIZE=3
QUEUE_NAME=tasks
QUEUE_LIMIT=100
MAX_ATTEMPTS=3
PUBLISH_TIMEOUT=2
SOURCE_RETRY_DELAY=0.2
INFERENCE_DELAY=0.1
PIPELINE_ENABLED=false
# Set false for traces/metrics. Batch exporters never block task processing.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
OTEL_SERVICE_VERSION=0.3.0
OTEL_DEPLOYMENT_ENVIRONMENT=dev
LOKI_IMAGE=grafana/loki:3.3.2
ALLOY_IMAGE=grafana/alloy:v1.5.1
TEMPO_IMAGE=grafana/tempo:2.6.1
COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.117.0
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
