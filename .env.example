POSTGRES_DB=mlops
POSTGRES_USER=mlops
POSTGRES_PASSWORD=

APP_PORT=8000
LOG_LEVEL=INFO

MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT_NAME=iris-classification
MLFLOW_MODEL_NAME=iris-classifier
MLFLOW_MODEL_ALIAS=champion

RABBITMQ_USER=mlops
RABBITMQ_PASSWORD=mlops_local
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=predict.tasks
RABBITMQ_QUEUE_MAX_LENGTH=10
WORKER_CONCURRENCY=1
WORKER_PREFETCH_COUNT=1
INFERENCE_DELAY=1.0
MAX_ATTEMPTS=3
RETRY_DELAY=0.1
PUBLISH_TIMEOUT=0.5
API_MAX_INFLIGHT=32
BACKPRESSURE_ENABLED=true

MODEL_CACHE_SIZE=3

MLOPS_CPU_LIMIT=1
RABBITMQ_CPU_LIMIT=2
