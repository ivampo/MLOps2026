{
  "uid": "pipeline",
  "title": "Конвейер",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Глубина очереди и лимит",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=\"$queue\"})",
          "legendFormat": "Задач"
        },
        {
          "refId": "B",
          "expr": "max(pipeline_queue_limit)",
          "legendFormat": "Лимит"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Источник и воркеры",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pipeline_source_published_total[1m]))",
          "legendFormat": "Источник"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pipeline_worker_processed_total{result=\"ok\"}[1m]))",
          "legendFormat": "Все воркеры"
        },
        {
          "refId": "C",
          "expr": "sum by(service_instance_id)(rate(pipeline_worker_processed_total{result=\"ok\",service_name=\"worker\",service_instance_id=~\"$worker\"}[1m]))",
          "legendFormat": "Воркер {{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Inference p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by(le)(rate(pipeline_inference_duration_seconds_bucket{service_name=\"worker\",service_instance_id=~\"$worker\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(pipeline_inference_duration_seconds_bucket{service_name=\"worker\",service_instance_id=~\"$worker\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le)(rate(pipeline_inference_duration_seconds_bucket{service_name=\"worker\",service_instance_id=~\"$worker\"}[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "API p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by(le)(rate(pipeline_api_duration_seconds_bucket{service_name=\"api\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(pipeline_api_duration_seconds_bucket{service_name=\"api\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(le)(rate(pipeline_api_duration_seconds_bucket{service_name=\"api\"}[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Память процессов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_process_memory_bytes{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} / {{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Доля ответов API 503",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pipeline_api_requests_total{status=\"503\"}[1m])) / clamp_min(sum(rate(pipeline_api_requests_total[1m])), 0.000001)",
          "legendFormat": "503"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Отказы брокера и ожидание источника",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pipeline_source_rejected_total[1m]))",
          "legendFormat": "Отказов/с"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pipeline_source_wait_seconds_total[1m]))",
          "legendFormat": "Ожидание с/с"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "DLQ и неподтверждённые сообщения",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=~\".*[.]dlq\"})",
          "legendFormat": "DLQ"
        },
        {
          "refId": "B",
          "expr": "sum(rabbitmq_detailed_queue_messages_unacked{queue=\"$queue\"})",
          "legendFormat": "Unacked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Задачи в работе и повторы",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pipeline_worker_inflight{service_name=\"worker\",service_instance_id=~\"$worker\"})",
          "legendFormat": "В работе"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pipeline_worker_redeliveries_total{service_name=\"worker\",service_instance_id=~\"$worker\"}[1m]))",
          "legendFormat": "Повторов/с"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "SLO: 99% задач успешно до 15 с",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pipeline_task_duration_seconds_bucket{le=\"15\",service_instance_id=~\"$worker\"}[5m])) / clamp_min(sum(rate(pipeline_worker_processed_total{result=~\"ok|dlq\",service_instance_id=~\"$worker\"}[5m])), 0.000001)",
          "legendFormat": "Доля"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Последние ошибки",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"dev\"} | json | level=~\"ERROR|CRITICAL\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 12,
      "title": "История задачи",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"dev\"} | json | task_id=~\"$task_id\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pipeline_process_memory_bytes, service_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "worker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pipeline_process_memory_bytes{service_name=\"worker\"}, service_instance_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(rabbitmq_detailed_queue_messages_ready{queue!~\".*[.]dlq\"}, queue)",
        "refresh": 2,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "tasks",
          "value": "tasks"
        }
      },
      {
        "name": "task_id",
        "type": "textbox",
        "label": "Task ID (regex)",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  }
}
